    const lightReports = [
      { protocol: 'LUZ-8841', sector: 'Parque Industrial', address: 'Av. das Indústrias, alt. nº 910', issue: 'Lâmpada LED apagada à noite', status: 'Equipe em deslocamento' },
      { protocol: 'LUZ-8839', sector: 'Vila Sol', address: 'Rua Girassol, nº 145', issue: 'Lâmpada piscando intermitente', status: 'Programado para hoje' }
    ];

    function renderLightingData() {
      const grid = document.getElementById('neighborhood-lighting-grid');
      let sumTotal = 0;
      let sumActive = 0;

      grid.innerHTML = lightingSectors.map(sec => {
        sumTotal += sec.total;
        sumActive += sec.active;
        const pct = ((sec.active / sec.total) * 100).toFixed(1).replace('.', ',');
        const isHigh = (sec.active / sec.total) >= 0.985;

        return `
          <div class="p-4 rounded-2xl border ${isHigh ? 'bg-emerald-50/60 border-emerald-200' : 'bg-amber-50/60 border-amber-200'}">
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-sm text-slate-900">${sec.name}</span>
              <span class="w-2.5 h-2.5 rounded-full ${isHigh ? 'bg-vanden-green' : 'bg-amber-500'}" aria-hidden="true"></span>
            </div>
            <p class="text-2xl font-display font-extrabold ${isHigh ? 'text-vanden-green' : 'text-amber-800'}">${pct}%</p>
            <p class="text-xs text-slate-600 mt-1">${sec.active.toLocaleString('pt-BR')} / ${sec.total.toLocaleString('pt-BR')} postes LED</p>
          </div>
        `;
      }).join('');

      const overall = ((sumActive / sumTotal) * 100).toFixed(1).replace('.', ',');
      document.getElementById('lighting-overall-pct').textContent = `${overall}% Ativo`;

      const list = document.getElementById('light-reports-list');
      list.innerHTML = lightReports.map(rep => `
        <li class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-start justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-extrabold px-2 py-0.5 rounded bg-vanden-yellowLight text-amber-900 border border-amber-300">${rep.protocol}</span>
              <span class="text-xs font-bold text-slate-700">${rep.sector}</span>
            </div>
            <p class="text-sm font-bold text-slate-900 mt-1">${rep.address}</p>
            <p class="text-xs text-slate-600">${rep.issue}</p>
          </div>
          <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-900 shrink-0">${rep.status}</span>
        </li>
      `).join('');
    }

    function openLightReportModal() {
      document.getElementById('light-report-modal').classList.remove('hidden');
      document.getElementById('light-address').focus();
    }

    function closeLightReportModal() {
      document.getElementById('light-report-modal').classList.add('hidden');
    }

    function submitLightReport(event) {
      event.preventDefault();
      const sector = document.getElementById('light-sector').value;
      const address = document.getElementById('light-address').value.trim();
      const issue = document.getElementById('light-issue').value;
      const protocol = 'LUZ-' + Math.floor(1000 + Math.random() * 9000);

      lightReports.unshift({
        protocol,
        sector,
        address,
        issue,
        status: 'Registrado agora'
      });

      const targetSector = lightingSectors.find(s => s.name === sector);
      if (targetSector && targetSector.active > 0) {
        targetSector.active -= 1;
      }

      renderLightingData();
      document.getElementById('light-address').value = '';
      closeLightReportModal();
      showToast(`Chamado ${protocol} registrado! Equipe de iluminação notificada.`);
    }

    // ==========================================
    // 5. PORTAL DA EDUCAÇÃO: BOLETIM E FREQUÊNCIA
    // ==========================================
    const mockStudentsDB = {
      '1024': {
        name: 'Lucas Gabriel Ferreira',
