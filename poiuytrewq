    // ==========================================
    // 4. ILUMINAÇÃO PÚBLICA INTELIGENTE
    // ==========================================
    const lightingSectors = [
      { name: 'Centro', total: 3400, active: 3380 },
      { name: 'Jardim Verde', total: 2950, active: 2925 },
      { name: 'Vila Sol', total: 2600, active: 2568 },
