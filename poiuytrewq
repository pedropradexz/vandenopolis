    let currentFontSize = 16;

    function changeFontSize(delta) {
      currentFontSize = Math.min(22, Math.max(13, currentFontSize + delta));
      document.documentElement.style.setProperty('--base-font-size', currentFontSize + 'px');
      showToast(`Tamanho do texto ajustado para ${Math.round((currentFontSize / 16) * 100)}%.`);
    }

    function resetFontSize() {
      currentFontSize = 16;
      document.documentElement.style.setProperty('--base-font-size', '16px');
      showToast('Tamanho do texto restaurado para o padrão (100%).');
    }

    function toggleHighContrast() {
      const isHC = document.body.classList.toggle('high-contrast');
      const btn = document.getElementById('btn-contrast');
      btn.setAttribute('aria-pressed', isHC ? 'true' : 'false');
      showToast(isHC ? 'Modo Alto Contraste ativado.' : 'Modo Alto Contraste desativado.');
    }

    function toggleReadableSpacing() {
      const isSpaced = document.body.classList.toggle('readable-spacing');
      const btn = document.getElementById('btn-spacing');
      btn.setAttribute('aria-pressed', isSpaced ? 'true' : 'false');
      showToast(isSpaced ? 'Espaçamento ampliado para leitura ativado.' : 'Espaçamento padrão restaurado.');
    }

    function showToast(message) {
      const toast = document.getElementById('toast-notification');
      const msgEl = document.getElementById('toast-message');
      msgEl.textContent = message;
      toast.classList.remove('hidden');
      clearTimeout(window.toastTimer);
      window.toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
      }, 4000);
    }

    // ==========================================
    // 2. AUTENTICAÇÃO DO MORADOR POR CPF
    // ==========================================
    let authenticatedCPF = '';

    const cpfInput = document.getElementById('cpf-input');
    cpfInput.addEventListener('input', function (e) {
      let digits = e.target.value.replace(/\D/g, '').slice(0, 11);
      if (digits.length > 9) {
        digits = digits.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
      } else if (digits.length > 6) {
        digits = digits.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
      } else if (digits.length > 3) {
        digits = digits.replace(/(\d{3})(\d{1,3})/, '$1.$2');
      }
      e.target.value = digits;
    });

    function fillDemoCPF() {
      cpfInput.value = '418.925.730-09';
      document.getElementById('cpf-error').classList.add('hidden');
      cpfInput.focus();
    }

    function handleCitizenLogin(event) {
      event.preventDefault();
      const rawDigits = cpfInput.value.replace(/\D/g, '');
      const errorBox = document.getElementById('cpf-error');

      if (rawDigits.length !== 11) {
        errorBox.textContent = 'Por favor, digite um CPF válido com 11 números.';
        errorBox.classList.remove('hidden');
        cpfInput.focus();
        return;
      }

      errorBox.classList.add('hidden');
      authenticatedCPF = cpfInput.value;

      // Atualiza cabeçalho com CPF mascarado
      const masked = `${rawDigits.slice(0, 3)}.***.***-${rawDigits.slice(9, 11)}`;
      document.getElementById('display-citizen-cpf').textContent = `CPF: ${masked}`;
      document.getElementById('user-header-info').classList.remove('hidden');
      document.getElementById('user-header-info').classList.add('flex');

      // Alterna telas
      document.getElementById('login-screen').classList.add('hidden');
      document.getElementById('portal-dashboard').classList.remove('hidden');

      renderLightingData();
      renderSchoolsList();
      showToast('Identificação confirmada! Bem-vindo(a) ao portal de Vandenópolis.');
    }

    function logoutCitizen() {
      authenticatedCPF = '';
      cpfInput.value = '';
      document.getElementById('user-header-info').classList.add('hidden');
      document.getElementById('user-header-info').classList.remove('flex');
      document.getElementById('portal-dashboard').classList.add('hidden');
      document.getElementById('login-screen').classList.remove('hidden');
      showToast('Você saiu do Portal do Cidadão.');
    }

    // ==========================================
    // 3. NAVEGAÇÃO ENTRE ABAS
    // ==========================================
    function switchTab(tabName) {
      const btnCidade = document.getElementById('tab-btn-cidade');
      const btnEducacao = document.getElementById('tab-btn-educacao');
      const panelCidade = document.getElementById('panel-cidade');
      const panelEducacao = document.getElementById('panel-educacao');

      if (tabName === 'cidade') {
        btnCidade.className = 'flex-1 min-w-[160px] py-3 px-4 rounded-xl font-display font-bold text-sm sm:text-base flex items-center justify-center gap-2 bg-vanden-green text-white shadow-sm transition';
