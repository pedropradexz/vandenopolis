        btnEducacao.className = 'flex-1 min-w-[160px] py-3 px-4 rounded-xl font-display font-bold text-sm sm:text-base flex items-center justify-center gap-2 bg-slate-100 text-slate-700 hover:bg-vanden-yellowLight transition';
