    function closeEnrollmentModal() {
      document.getElementById('enrollment-modal').classList.add('hidden');
    }

    function submitEnrollment(event) {
      event.preventDefault();
      const schoolId = document.getElementById('enroll-school-id').value;
      const studentName = document.getElementById('enroll-student-name').value.trim();
      const grade = document.getElementById('enroll-grade').value;
      const shift = document.getElementById('enroll-shift').value;

      const school = schoolsCatalog.find(s => s.id === schoolId);
      if (school && school.availableSpots > 0) {
        school.availableSpots -= 1;
      }

      const newReg = Math.floor(4000 + Math.random() * 5999);
      const protocol = `MAT-2026-${newReg}`;

      // Adiciona ao painel de matrículas confirmadas
      const box = document.getElementById('confirmed-enrollments-box');
      const list = document.getElementById('confirmed-enrollments-list');
      box.classList.remove('hidden');

      const li = document.createElement('li');
      li.className = 'bg-white p-3 rounded-xl border border-emerald-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2';
      li.innerHTML = `
        <div>
          <strong class="text-slate-900">${studentName}</strong> — ${school.name} (${grade} • ${shift})
        </div>
        <span class="px-2.5 py-1 rounded-lg bg-vanden-yellow text-slate-900 font-extrabold text-xs shrink-0">
          Protocolo: ${protocol} • Matrícula: #${newReg}
        </span>
      `;
      list.prepend(li);

      // Limpa e fecha modal
      document.getElementById('enroll-student-name').value = '';
      document.getElementById('enroll-birth').value = '';
      document.getElementById('enroll-guardian').value = '';
      closeEnrollmentModal();
      renderSchoolsList();

      showToast(`Matrícula de ${studentName} confirmada! Protocolo ${protocol}.`);
    }
  </script>
</body>
</html>
