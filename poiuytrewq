    function generateDynamicStudent(reg) {
      const seed = parseInt(reg, 10);
      const names = ['Ana Clara Mendes', 'Rafael Augusto Lima', 'Beatriz Souza Rocha', 'Gabriel Martins Alves', 'Sofia Helena Cardoso'];
      const grades = ['4º Ano A • Ensino Fundamental I', '6º Ano B • Ensino Fundamental II', '8º Ano A • Ensino Fundamental II'];
      const baseGrade = 7.2 + ((seed % 20) / 10);

      const makeScore = (offset) => Math.min(10, Math.max(6.5, +(baseGrade + offset).toFixed(1)));

      return {
        name: names[seed % names.length],
        grade: `${grades[seed % grades.length]} • Turno: Manhã`,
        attendance: 90 + (seed % 10),
        subjects: [
          { name: 'Língua Portuguesa', b1: makeScore(0.2), b2: makeScore(0.4), b3: makeScore(0.3), b4: makeScore(0.6) },
          { name: 'Matemática', b1: makeScore(-0.2), b2: makeScore(0.1), b3: makeScore(0.4), b4: makeScore(0.5) },
          { name: 'Ciências da Natureza', b1: makeScore(0.3), b2: makeScore(0.5), b3: makeScore(0.4), b4: makeScore(0.7) },
          { name: 'História', b1: makeScore(0.1), b2: makeScore(0.3), b3: makeScore(0.5), b4: makeScore(0.5) },
          { name: 'Geografia', b1: makeScore(0.0), b2: makeScore(0.2), b3: makeScore(0.4), b4: makeScore(0.6) },
          { name: 'Educação Física', b1: 9.5, b2: 9.5, b3: 10.0, b4: 10.0 }
        ]
      };
    }

    function handleStudentSearch(event) {
      if (event) event.preventDefault();
      const reg = document.getElementById('student-reg-input').value.trim();
      const school = document.getElementById('student-school-select').value;
      const errorEl = document.getElementById('student-search-error');

      if (!/^\d{4}$/.test(reg)) {
        errorEl.textContent = 'O Registro de Matrícula deve conter exatamente 4 números (exemplo: 1024).';
        errorEl.classList.remove('hidden');
        document.getElementById('student-reg-input').focus();
        return;
      }

      errorEl.classList.add('hidden');
      const student = mockStudentsDB[reg] || generateDynamicStudent(reg);

      document.getElementById('res-student-reg').textContent = `MATRÍCULA #${reg}`;
      document.getElementById('res-student-school').textContent = school;
      document.getElementById('res-student-name').textContent = student.name;
      document.getElementById('res-student-grade').textContent = student.grade;
      document.getElementById('res-student-attendance').textContent = `${student.attendance}%`;
      document.getElementById('res-attendance-badge').textContent = student.attendance >= 75 ? 'Frequência Regular' : 'Atenção';

      const tbody = document.getElementById('res-grades-tbody');
      tbody.innerHTML = student.subjects.map(sub => {
        const avg = ((sub.b1 + sub.b2 + sub.b3 + sub.b4) / 4).toFixed(1);
        const approved = parseFloat(avg) >= 6.0;
        return `
          <tr class="hover:bg-slate-50 transition">
            <td class="py-3 px-4 font-bold text-slate-900">${sub.name}</td>
            <td class="py-3 px-3 text-center font-medium">${sub.b1.toFixed(1)}</td>
            <td class="py-3 px-3 text-center font-medium">${sub.b2.toFixed(1)}</td>
            <td class="py-3 px-3 text-center font-medium">${sub.b3.toFixed(1)}</td>
            <td class="py-3 px-3 text-center font-medium">${sub.b4.toFixed(1)}</td>
            <td class="py-3 px-3 text-center font-extrabold text-vanden-green">${avg}</td>
            <td class="py-3 px-4 text-right">
              <span class="px-2.5 py-1 rounded-full text-xs font-extrabold ${approved ? 'bg-emerald-100 text-emerald-900' : 'bg-amber-100 text-amber-900'}">
